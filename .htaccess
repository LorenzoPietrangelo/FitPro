Options -Indexes

RewriteEngine On

# ── Protezione cartelle non pubbliche ────────────────────────────────────────
RewriteRule ^(configs|vendor|templates|templates_c|cache|uploads)/  - [F,L]

# ── Protezione file sensibili nella root ─────────────────────────────────────
RewriteRule ^(composer\.(json|lock)|\.env.*|.*\.sql|.*\.log)$  - [F,L]

# ── Router: tutto ciò che non è un file/dir fisico → index.php ───────────────
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [QSA,L]
